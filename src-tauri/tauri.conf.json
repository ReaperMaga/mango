{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mango",
  "version": "../package.json",
  "identifier": "dev.mango.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../.output/public",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mango",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A desktop agent workbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwRkI5QkM1RUM1MDczNTkKUldSWmMxRHN4WnY3VVBxallxeTkzbG9OaEdyUnJGajFsd2dscUF3M1ZNditONERPaGhXYlFRVHgK",
      "endpoints": [
        "https://github.com/ReaperMaga/mango/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
