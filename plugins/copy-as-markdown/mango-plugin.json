{
  "id": "copy-as-markdown",
  "name": "Copy as Markdown",
  "version": "1.0.0",
  "description": "Copy a reply, or a whole chat as a readable transcript, as Markdown.",
  "author": "Mango",
  "homepage": "https://github.com/ReaperMaga/mango/tree/main/plugins/copy-as-markdown",
  "main": "main.js",
  "minAppVersion": "0.1.36",
  "settings": [
    {
      "key": "tools",
      "type": "select",
      "label": "Tool calls in a chat transcript",
      "default": "list",
      "options": [
        { "value": "list", "label": "One line each" },
        { "value": "output", "label": "With their output" },
        { "value": "none", "label": "Leave them out" }
      ]
    },
    {
      "key": "thinking",
      "type": "boolean",
      "label": "Include the agent's thinking",
      "default": false
    }
  ]
}
